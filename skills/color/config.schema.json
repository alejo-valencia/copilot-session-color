{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Copilot Session Color configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "theme",
    "prompts",
    "sessions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "namedColors",
        "decoration",
        "boldTitle",
        "titleWidth",
        "titleBackground",
        "showDirectory",
        "directorySeparator",
        "fallbackSessionName"
      ],
      "properties": {
        "palette": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "namedColors": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "decoration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "leftGlyphs",
            "rightGlyphs",
            "intensities"
          ],
          "properties": {
            "leftGlyphs": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2
              }
            },
            "rightGlyphs": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2
              }
            },
            "intensities": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "boldTitle": {
          "type": "boolean"
        },
        "titleWidth": {
          "type": "integer",
          "minimum": 8,
          "maximum": 120
        },
        "titleBackground": {
          "type": "string",
          "enum": [
            "solid",
            "none"
          ]
        },
        "showDirectory": {
          "type": "boolean"
        },
        "directorySeparator": {
          "type": "string",
          "maxLength": 4
        },
        "fallbackSessionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restartNotice"
      ],
      "properties": {
        "restartNotice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ansiColor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    }
  }
}
